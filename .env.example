# --- Server ---
PORT=8080
# DB_PATH=/data/blastmates.db
# UPLOADS_DIR=/data/uploads
# CLIENT_DIST=/app/public
# Drizzle migrations folder (default: ./drizzle next to the server).
# MIGRATIONS_DIR=/app/drizzle

# --- Public room ready-start (defaults shown) ---
# Anti-stall timer: force-start this long after the first ready-up.
# READY_TIMEOUT_MS=60000
# Bot fill: pad a sub-2-player start up to this many participants.
# BOT_FILL_TARGET=4

# --- Accounts / email (https://resend.com/api-keys) ---
# Unset RESEND_API_KEY = verification/reset emails are logged to the console.
RESEND_API_KEY=
# EMAIL_FROM=Blastmates <noreply@yourdomain.com>
# REQUIRED in production: canonical https origin for email links. Without it,
# links fall back to the request Host header (spoofable -> reset-link hijack).
# APP_ORIGIN=https://blastmates.com

# --- Admin ---
# The /admin zone is gated by an account's is_admin flag, not an env token.
# Grant admin via SEED_ADMIN_EMAILS in packages/server/src/store.ts (applied on
# boot) or by setting is_admin = 1 in the DB. In dev a test login is seeded:
# john@example.com / password (never seeded when NODE_ENV=production).

# --- Lemon Squeezy (https://app.lemonsqueezy.com/settings/api) ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LS_STORE_ID=
LS_VARIANT_ID_BRICK_1X1=
LS_VARIANT_ID_BRICK_2X1=
LS_VARIANT_ID_BRICK_3X1=
LS_VARIANT_ID_SKIN=
